# ==============================================================================
# FaceSentinel Integration Client (.env.example)
# Plantilla de Configuración del Cliente de Integración SSO
# ==============================================================================

# Puerto del Servidor Cliente
PORT=3005

# Identificador único registrado en FaceSentinel
CLIENT_ID=APP_ECOMMERCE_001
FACESENTINEL_CLIENT_ID=APP_ECOMMERCE_001

# Secreto de cliente compartido (si aplica)
CLIENT_SECRET=tu_client_secret_aqui

# Clave secreta para firmar cookies de sesión local
SESSION_SECRET=tu_session_secret_aqui

# URL Pública del Frontend de FaceSentinel (:8088)
FACESENTINEL_PUBLIC_URL=http://localhost:8088
FACESENTINEL_FRONTEND_URL=http://localhost:8088

# URL del Backend REST de FaceSentinel (:8001)
FACESENTINEL_BACKEND_URL=http://127.0.0.1:8001
FACESENTINEL_HTTP_URL=http://127.0.0.1:8001

# URL del WebSocket de FaceSentinel para Liveness en tiempo real
FACESENTINEL_WS_URL=ws://localhost:8088/api/v1/ws/liveness

# Callback exacto de retorno tras la autenticación
REDIRECT_URI=http://localhost:3005/callback
CLIENT_URL=http://localhost:3005

# Clave simétrica de firma JWT del IdP FaceSentinel
JWT_SECRET_KEY=tu_jwt_secret_key_aqui
JWT_ALGORITHM=HS256
